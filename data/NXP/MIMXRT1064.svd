                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EDGCNTA_EN_1</name>
                  <description>Edge counter enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
