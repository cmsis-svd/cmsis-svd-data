              <enumeratedValues>
                <enumeratedValue>
                  <name>MG_0</name>
                  <description>the corresponding bit in the filter is &quot;don't care&quot;</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MG_1</name>
                  <description>The corresponding bit in the filter is checked against the one received</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RX14MASK</name>
          <description>Rx Buffer 14 Mask Register</description>
