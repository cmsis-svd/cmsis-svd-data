                  <description>8-bit data bus mode.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>18_BIT</name>
                  <description>18-bit data bus mode.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24_BIT</name>
                  <description>24-bit data bus mode.</description>
                  <value>0x3</value>
                </enumeratedValue>
