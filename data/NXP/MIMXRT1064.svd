            </field>
            <field>
              <name>BUF5I</name>
              <description>If the Rx FIFO is not enabled, this bit flags the interrupt for MB5</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BUF5I_0</name>
