                </enumeratedValue>
                <enumeratedValue>
                  <name>RF_1</name>
                  <description>New reload cycle since last STS[RF] clearing</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>REF</name>
              <description>Reload Error Flag</description>
