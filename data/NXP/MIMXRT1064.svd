              <enumeratedValues>
                <enumeratedValue>
                  <name>PWAOT0_0</name>
                  <description>Route the PWM_OUT_TRIG0 signal to PWM_OUT_TRIG0 port.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWAOT0_1</name>
                  <description>Route the PWMA output to the PWM_OUT_TRIG0 port.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
