                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWAOT0_1</name>
                  <description>Route the PWMA output to the PWM_OUT_TRIG0 port.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
