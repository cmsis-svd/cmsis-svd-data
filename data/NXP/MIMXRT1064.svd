                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SCS_2</name>
                  <description>Counter 2 input pin</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
