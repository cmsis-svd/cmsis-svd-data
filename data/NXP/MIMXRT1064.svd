              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CCIR_EN_0</name>
                  <description>Traditional interface is selected. Timing interface logic is used to latch data.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CCIR_EN_1</name>
                  <description>CCIR656 interface is selected.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSYNC_POL</name>
