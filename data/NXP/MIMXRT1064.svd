                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SPLIT_1</name>
                  <description>DBLPWM is split to PWMA and PWMB.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRSC</name>
              <description>Prescaler</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
