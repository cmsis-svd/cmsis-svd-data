          <fields>
            <field>
              <name>COUNTER</name>
              <description>This read/write register is the counter for the corresponding channel in a timer module.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
