              </enumeratedValues>
            </field>
            <field>
              <name>F1_INT</name>
              <description>CCIR Field 1 Interrupt Status</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
