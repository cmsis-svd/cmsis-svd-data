            <field>
              <name>WORD_LENGTH</name>
              <description>Input data format.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>16_BIT</name>
                  <description>Input data is 16 bits per pixel.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_BIT</name>
                  <description>Input data is 8 bits wide.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>18_BIT</name>
                  <description>Input data is 18 bits per pixel.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24_BIT</name>
                  <description>Input data is 24 bits per pixel.</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LCD_DATABUS_WIDTH</name>
              <description>LCD Data bus transfer width.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>16_BIT</name>
                  <description>16-bit data bus mode.</description>
                  <value>0</value>
                </enumeratedValue>
