                <enumeratedValue>
                  <name>BOFFMSK_1</name>
                  <description>Bus Off interrupt enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PSEG2</name>
              <description>This 3-bit field defines the length of Phase Buffer Segment 2 in the bit time</description>
