                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STRFWD_1</name>
                  <description>Enabled.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
