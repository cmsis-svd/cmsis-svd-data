                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AXBS_P_FORCE_ROUND_ROBIN_1</name>
                  <description>AXBS_P masters are arbitored in round robin</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CANFD_FILTER_BYPASS</name>
              <description>Disable CANFD filter</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CANFD_FILTER_BYPASS_0</name>
                  <description>enable CANFD filter</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CANFD_FILTER_BYPASS_1</name>
                  <description>disable CANFD filter</description>
                  <value>0x1</value>
                </enumeratedValue>
