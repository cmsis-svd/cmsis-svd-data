              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SZ_0</name>
                  <description>0MB. AHBP disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SZ_1</name>
                  <description>64MB.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SZ_2</name>
                  <description>128MB.</description>
                  <value>0x2</value>
                </enumeratedValue>
