                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RXEDGIF_1</name>
                  <description>An active edge on the receive pin has occurred.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
