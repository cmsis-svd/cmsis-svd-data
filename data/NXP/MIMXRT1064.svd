              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>START_0</name>
                  <description>The channel is not explicitly started.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_1</name>
                  <description>The channel is explicitly started via a software initiated service request.</description>
                  <value>0x1</value>
