                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INDEP_1</name>
                  <description>PWM_A and PWM_B outputs are independent PWMs.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
