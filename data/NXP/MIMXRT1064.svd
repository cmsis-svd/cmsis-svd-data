                  <description>PWM clock frequency = fclk/4</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRSC_3</name>
                  <description>PWM clock frequency = fclk/8</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
