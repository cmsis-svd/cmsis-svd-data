          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>HSYNC_PERIOD</name>
              <description>Total number of DISPLAY CLOCK (pix_clk) cycles between two positive or two negative edges of the HSYNC signal</description>
              <bitOffset>0</bitOffset>
              <bitWidth>18</bitWidth>
              <access>read-write</access>
            </field>
