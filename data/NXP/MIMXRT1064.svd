                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RETEN_1</name>
                  <description>Retry phase enabled.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SZ</name>
              <description>TCM size. Indicates the size of the relevant TCM.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
