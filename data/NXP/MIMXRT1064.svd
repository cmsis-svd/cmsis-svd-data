              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DEINTERLACE_STRIDE</name>
              <description>DEINTERLACE_STRIDE is only used in the deinterlace mode</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
