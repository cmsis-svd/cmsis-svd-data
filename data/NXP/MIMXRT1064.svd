                  <description>PWM clock frequency = fclk/64</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRSC_7</name>
                  <description>PWM clock frequency = fclk/128</description>
                  <value>0x7</value>
                </enumeratedValue>
