                  <description>DMA write requests disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VALDE_1</name>
                  <description>DMA write requests for the VALx and FRACVALx registers enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
