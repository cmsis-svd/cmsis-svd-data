                  <enumeratedValue>
                    <name>TIF_0</name>
                    <description>Timeout has not yet occurred.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TIF_1</name>
                    <description>Timeout has occurred.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
