    <peripheral derivedFrom="CMP1">
      <name>CMP2</name>
      <description>High-Speed Comparator (CMP), Voltage Reference (VREF) Digital-to-Analog Converter (DAC), and Analog Mux (ANMUX)</description>
      <groupName>ACMP</groupName>
      <prependToName>CMP2_</prependToName>
      <baseAddress>0x40094008</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x6</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>ACMP2</name>
